{
  "id": "example:repeater_state",
  "default": "off",

  "states": [
    {
      "name": "delay_one",
      "type": "boolean",
      "condition": {
        "type": "property_equals",
        "property": "delay",
        "value": 1
      }
    },
    {
      "name": "delay_two",
      "type": "boolean",
      "condition": {
        "type": "property_equals",
        "property": "delay",
        "value": 2
      }
    },
    {
      "name": "delay_three",
      "type": "boolean",
      "condition": {
        "type": "property_equals",
        "property": "delay",
        "value": 3
      }
    },
    {
      "name": "off",
      "type": "boolean",
      "condition": {
        "type": "property_equals",
        "property": "delay",
        "value": 4
      }
    }
  ],

  "transitions": [
    {
      "from": "delay_one",
      "to": "delay_two",
      "duration": 5000,
      "condition": {
        "type": "neighbor_solid",
        "direction": "down"
      }
    },
    {
      "from": "delay_two",
      "to": "delay_three",
      "duration": 5000
    },
    {
      "from": "delay_three",
      "to": "off",
      "duration": 5000
    }
  ]
}